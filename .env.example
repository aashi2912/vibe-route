# Copy to .env and fill in. .env is gitignored — never commit real keys.

# BROWSER key — Maps JavaScript SDK only (map + Places Autocomplete).
# Lock in Google Cloud: HTTP referrers = your domain + localhost;
# API restriction = Maps JavaScript API + Places API only.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# SERVER key — Places (New) + Routes v2 REST. Used only by /api proxies.
# Never prefixed with VITE_, never shipped to the browser.
GOOGLE_MAPS_SERVER_KEY=

# SERVER key — Anthropic. Used by /api/narrative and /api/parse-vibes.
LLM_API_KEY=
